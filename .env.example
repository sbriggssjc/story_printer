# Story Printer — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- Audio input ---
# Substring to match your microphone name (e.g. "rode", "yeti", "usb")
# Run: python tools/probe_mics.py  to find your device
INPUT_DEVICE_NAME=rode
# Or set an explicit device index (overrides name search):
# INPUT_DEVICE_INDEX=2

# --- Printing ---
# CUPS printer name (leave blank for system default)
# Run: lpstat -p  to list printers
PRINTER_NAME=
# Set to 0 to disable auto-printing
AUTO_PRINT=1

# --- Story generation ---
STORY_ENHANCE_MODE=openai
STORY_IMAGE_MODE=openai
STORY_TARGET_PAGES=2
STORY_WORDS_PER_PAGE=260
STORY_VOICE_MODE=kid
STORY_FIDELITY_MODE=fun

# --- Advanced ---
# STORY_MODEL=gpt-4o-mini
# STORY_TEMPERATURE=0.7
# STORY_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
